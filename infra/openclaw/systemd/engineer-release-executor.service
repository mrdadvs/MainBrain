[Unit]
Description=MainBrain Engineer Release Executor (trusted skeleton)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mdv/mainbrain
EnvironmentFile=-/home/mdv/mainbrain/infra/openclaw/.env.local
EnvironmentFile=-/home/mdv/.config/mainbrain/engineer-release-approver.env
Environment=ENGINEER_RELEASE_EXECUTOR_SOCKET_PATH=/home/mdv/mainbrain/data/engineer-release-executor/release-executor.sock
Environment=ENGINEER_RELEASE_EXECUTOR_STATE_DIR=/home/mdv/.local/state/mainbrain/engineer-release-executor
Environment=ENGINEER_RELEASE_EXECUTOR_POLICY_FILE=/home/mdv/mainbrain/apps/engineer_release_executor/config/trusted_policy.json
Environment=ENGINEER_RELEASE_EXECUTOR_WORKSPACES_ROOT=/home/mdv/mainbrain/data/engineer-code-mcp/workspaces
Environment=ENGINEER_RELEASE_EXECUTOR_WORKSPACE_META_ROOT=/home/mdv/mainbrain/data/engineer-code-mcp/workspaces/_engineer_meta
Environment=ENGINEER_RELEASE_EXECUTOR_ALLOWED_PEER_UID=1000
Environment=ENGINEER_RELEASE_EXECUTOR_AUTH_TOKEN=engineer-release-executor-dev-token
Environment=ENGINEER_RELEASE_EXECUTOR_EVIDENCE_AUTH_TOKEN=engineer-release-evidence-dev-token
Environment=ENGINEER_RELEASE_EXECUTOR_DISCORD_INTENT_TTL_MINUTES=15
Environment=ENGINEER_RELEASE_EXECUTOR_DISCORD_APPROVAL_TTL_MINUTES=60
ExecStart=/home/mdv/mainbrain/infra/openclaw/scripts/run-engineer-release-executor.sh
Restart=always
RestartSec=2
UMask=007
NoNewPrivileges=true

[Install]
WantedBy=default.target
