# OpenClaw MainBrain Deployment - Environment Configuration
# 
# SECURITY WARNING: DO NOT COMMIT THIS FILE WITH REAL SECRETS
# Use .env.local (git-ignored) for actual deployment secrets
# This file is a template showing all required and optional variables

# ============================================================================
# Docker Image Configuration
# ============================================================================
IMAGE_REGISTRY=ghcr.io/sunwood-ai-oss-hub/agentos-openclaw-base
IMAGE_TAG=v0.2.1

# Container execution user (non-root for security)
CONTAINER_UID=1000
CONTAINER_GID=1000

# ============================================================================
# Persistent State and Workspace Directories
# ============================================================================
# These directories survive container replacement and host reboots
DATA_STATE_DIR=/home/mdv/mainbrain/data/openclaw/state
WORKSPACE_DIR=/home/mdv/mainbrain/data/openclaw/workspace

# ============================================================================
# Gateway Configuration
# ============================================================================
# Gateway token: Generate with: openssl rand -hex 32
# NEVER hardcode real tokens in this file - use .env.local
OPENCLAW_GATEWAY_TOKEN=placeholder_generate_with_openssl_rand_hex_32

# Gateway binds to localhost only (dashboard not exposed to network)
OPENCLAW_GATEWAY_PORT=8080

# ============================================================================
# Discord Integration (REQUIRED)
# ============================================================================
# Discord bot token from https://discord.com/developers/applications
# Get via: Applications > Your App > Bot > TOKEN
# NEVER hardcode real tokens in this file - use .env.local
DISCORD_BOT_TOKEN=placeholder_discord_bot_token

# Server and channel allowlist (security: restrict to specific Discord IDs)
DISCORD_SERVER_ID=placeholder_your_server_id
DISCORD_CHANNEL_ID=placeholder_your_channel_id

# Optional: User ID allowlist (comma-separated)
# Only these Discord user IDs can trigger the agent
DISCORD_ALLOWED_USERS=placeholder_your_discord_user_id

# Require bot mention before responding (recommended)
DISCORD_REQUIRE_MENTION=true

# ============================================================================
# AI Provider Configuration
# ============================================================================

# OpenAI API (RECOMMENDED for pilot)
# Get from: https://platform.openai.com/api-keys
# Model: gpt-4-turbo or gpt-3.5-turbo
OPENAI_API_KEY=placeholder_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Alternative OpenAI-compatible provider
# OPENAI_BASE_URL=https://api.your-provider.com/v1

# Z.AI (Zhipu GLM) - Optional alternative provider
# Get from: https://open.bigmodel.cn/
ZAI_API_KEY=placeholder_zai_api_key

# OpenRouter - Optional alternative provider
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=placeholder_openrouter_api_key

# ============================================================================
# Agent Behavior Configuration
# ============================================================================
LOG_LEVEL=info

# Agent instructions mode: only allow chat in pilot phase
AGENT_CHAT_ONLY=true

# Disable skills/plugins during pilot testing
AGENT_DISABLE_SKILLS=true

# ============================================================================
# Deployment and Maintenance
# ============================================================================
# Automatic backup interval (in hours, set to 0 to disable)
BACKUP_INTERVAL_HOURS=24

# Maximum backup retention (number of old backups to keep)
MAX_BACKUPS=10

# Enable debug logging for troubleshooting (verbose output)
DEBUG_MODE=false
